# Webapp client — base URL the browser uses to reach the PocketBase API.
# In Docker (single image, nginx proxy on :80) this is the same origin: leave blank
# or set to /api. For local dev, point at the standalone PocketBase port.
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# PocketBase superuser credentials. These are REQUIRED AT RUNTIME, not just by
# tooling: getPbAsSuperuser() in the webapp authenticates with them for every
# privileged operation, so without them the Garage cluster read cache, storage
# invites, user-to-user transfers, cluster-event writes, metrics history and the
# admin invite flow all return 500.
#
# They are also used by the migration tooling (yarn db:migrate / db:status) and
# by `yarn workspace @garage-ware/pb seed-admin <email>`, which falls back to
# reading webapp/.env when the vars are not already in its environment.
#
# In Docker you can leave both UNSET: the container generates a password on
# first boot and stores it at /data/pb_superuser.env (mode 0600). Setting only
# one of the two is a hard error rather than a partial configuration.
POCKETBASE_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=admin@example.com
POCKETBASE_ADMIN_PASSWORD=change-me

# Garage HQ admin API. Consumed by the webapp's /api/garage/* route handlers
# AND by the PocketBase node-metrics-scrape cron (via $os.getenv), so the PB
# process must see these too: `yarn workspace @garage-ware/pb dev` sources
# webapp/.env itself; in Docker pass them with `docker run -e`. These vars
# must NEVER be prefixed NEXT_PUBLIC_ since the bearer token must not ship
# to the browser.
GARAGE_ADMIN_URL=http://localhost:3903
GARAGE_ADMIN_TOKEN=replace-with-the-output-of-garage-admin-token-create

# Garage S3 gateway — used by the in-app file browser, which signs requests in
# the BROWSER with user-supplied S3 credentials (never stored). These are
# (non-secret) public values served to the browser at runtime by the
# /next-api/config route, NOT inlined at build time — so they are plain
# server-side env (no NEXT_PUBLIC_ prefix) and a single built image can be
# pointed at any cluster by setting these at runtime.
# GARAGE_S3_ENDPOINT is REQUIRED and has no default — set it to your own
# cluster's gateway. /next-api/config returns a 500 explaining as much when it
# is unset, and the file browser + connect page surface that error.
# NOTE: because the browser talks to the gateway directly, the bucket must allow
# CORS from this app's origin (GET/PUT/HEAD + authorization/x-amz-*/content-type
# request headers, ETag exposed) — otherwise the browser blocks the requests.
GARAGE_S3_ENDPOINT=https://s3.example.com
GARAGE_S3_REGION=us-east-1

# Optional: average object size in MB used to derive each bucket's maxObjects
# quota from its byte quota (maxObjects = floor(quota_bytes / (this * 1MB))).
# Server-only, read by the /next-api/garage/buckets handlers when a bucket's
# quota is created or changed. Leave unset to apply no object-count cap.
# GARAGE_AVG_OBJECT_SIZE_MB=4

# Optional: public-facing endpoint shown on the bucket "connect" page for users
# to paste into their own S3 tools (aws cli, rclone, etc). The in-app file
# browser still uses GARAGE_S3_ENDPOINT above (it needs the CORS-enabled gateway).
# Set this when you advertise a different URL to users than the one the app's
# browser client talks to. Falls back to GARAGE_S3_ENDPOINT.
# GARAGE_PUBLIC_S3_ENDPOINT=https://s3.example.com

# Public URL of the webapp, used by the PocketBase daily bucket-usage-alerts
# cron to build absolute CTA links in emails. Server-only; the PB process must
# see this in its environment. Leave unset and the cron logs a warning + skips.
APP_PUBLIC_URL=http://localhost:3000

# Optional: days of per-node metrics history the node-metrics-scrape cron
# keeps (it prunes older NodeMetrics rows each run). 0 = keep forever.
# NODE_METRICS_RETENTION_DAYS=90

# Optional: what storage costs on this cluster, used by the dashboard's cost
# comparison card. Server-only, read at request time and served to the browser
# by /next-api/config/pricing.
#
# GARAGE_COST_USD_PER_TB is the one-time cost of one TB of RAW DISK — what you
# paid for the drive. The cluster's replication factor is applied on top, from
# the live layout, so at RF 3 a usable terabyte costs three times this. Leaving
# the replication factor out would understate the cluster's cost, and overstate
# the saving, by exactly the replication factor.
# GARAGE_HARDWARE_LIFESPAN_YEARS is the period that capital is spread over.
# Non-numeric or non-positive values fall back to the defaults below.
# GARAGE_COST_USD_PER_TB=22
# GARAGE_HARDWARE_LIFESPAN_YEARS=5

# ---------------------------------------------------------------------------
# First-run setup
# ---------------------------------------------------------------------------
# Who may create an account: closed (default) | invite | open.
#   closed — nobody; admins create every account
#   invite — only addresses holding a pending storage invite, plus accounts an
#            admin creates from /admin/users
#   open   — anyone who can reach the sign-up page
# Enforced by a PocketBase hook (pb_hooks/lib/signup-gate.js), so the PB process
# must see it. Unset or unrecognised falls back to `closed`, never `open`.
# While no administrator exists yet, sign-up stays open regardless, so the owner
# can create the account they will claim with — claim promptly.
SIGNUP_MODE=closed

# ---------------------------------------------------------------------------
# Community self-service features. Both default OFF; only `true` or `1`
# enables. Read by the Next.js process at request time — no rebuild needed.
# ---------------------------------------------------------------------------
# Let users claim ownership of a cluster node themselves (by proving its full
# node id) and release it again. Off = only admins assign node owners, on
# /admin/nodes; an assigned owner still grants storage sourced from their node
# either way, and /dashboard/nodes stays available to everyone.
# FEATURE_NODE_CLAIMS=true

# Let users self-claim pre-existing Garage access keys (by proving the secret)
# and the buckets those keys own. Off = admins onboard existing assets via
# import on /admin/keys and /admin/buckets.
# FEATURE_ASSET_CLAIMS=true

# Optional: auto-promote whoever signs up with this address to administrator,
# instead of using the one-time claim token the container prints to its logs.
# Only applies while NO administrator exists yet, so it is not a standing back
# door. Read by the PB process via $os.getenv.
#
# Weaker than the claim token: an address is rarely secret, sign-up stays open
# until the instance is claimed, and email is not verified — so whoever reaches
# the app first with that address wins. Prefer the token on anything public.
# SETUP_OWNER_EMAIL=you@example.com

# Optional: supply the admin claim token yourself rather than letting the
# container mint one (e.g. from a secret manager). When set, nothing is written
# to disk. Only ever accepted while no administrator exists.
# SETUP_CLAIM_TOKEN=

# Where first-run state lives (claim token, claimed marker). The Docker image
# sets this to /data/setup. Local dev has no /data, so point it somewhere real
# if you want to exercise the /setup flow outside a container.
# SETUP_STATE_DIR=./.setup

NODE_ENV=development
