{
  "name": "@garage-ware/pb",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'set -a; [ -f ../webapp/.env ] && . ../webapp/.env; set +a; exec ./pocketbase serve'",
    "build": "echo 'PocketBase workspace - no build needed'",
    "test": "echo 'PocketBase workspace - no tests needed'",
    "test:watch": "echo 'PocketBase workspace - no tests needed'",
    "lint": "echo 'PocketBase workspace - no lint needed'",
    "lint:fix": "echo 'PocketBase workspace - no lint needed'",
    "typecheck": "echo 'PocketBase workspace - no typecheck needed'",
    "format": "echo 'PocketBase workspace - no format needed'",
    "format:check": "echo 'PocketBase workspace - no format check needed'",
    "serve": "./pocketbase serve",
    "admin": "sh -c '[ -n \"$1\" ] && [ -n \"$2\" ] || { echo \"Usage: yarn workspace @garage-ware/pb admin <email> <password>\"; exit 1; }; exec ./pocketbase superuser upsert \"$1\" \"$2\"' --",
    "seed-admin": "node scripts/seed-admin.mjs",
    "clean": "rm -rf pb_data"
  },
  "packageManager": "yarn@4.12.0"
}
