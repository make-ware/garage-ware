{
  "name": "garage-ware",
  "version": "1.8.2",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/make-ware/garage-ware.git"
  },
  "homepage": "https://github.com/make-ware/garage-ware#readme",
  "bugs": {
    "url": "https://github.com/make-ware/garage-ware/issues"
  },
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "webapp",
    "shared",
    "pocketbase"
  ],
  "scripts": {
    "setup": "node pocketbase/scripts/setup-pocketbase.js",
    "dev": "concurrently \"yarn workspace @garage-ware/webapp dev\" \"yarn workspace @garage-ware/shared dev\" \"yarn workspace @garage-ware/pb dev\"",
    "build": "yarn workspaces foreach -A run build",
    "build:shared": "yarn workspace @garage-ware/shared build",
    "test": "yarn workspace @garage-ware/shared test && yarn workspace @garage-ware/webapp test",
    "test:watch": "concurrently \"yarn workspace @garage-ware/shared test:watch\" \"yarn workspace @garage-ware/webapp test:watch\"",
    "lint:check": "yarn workspaces foreach -A run lint",
    "lint": "yarn workspaces foreach -A run lint:fix",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "format": "yarn workspaces foreach -A run format",
    "format:check": "yarn workspaces foreach -A run format:check",
    "clean": "yarn workspaces foreach -R run clean && rm -rf pocketbase/pocketbase",
    "check:refs": "node scripts/check-tracked-inputs.mjs",
    "precommit": "yarn run check:refs && yarn run build:shared && yarn run lint && yarn run typecheck && yarn run format && yarn run test",
    "db:migrate": "yarn workspace @garage-ware/shared migrate:generate",
    "db:status": "yarn workspace @garage-ware/shared migrate:status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^10",
    "eslint": "^9.39.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
